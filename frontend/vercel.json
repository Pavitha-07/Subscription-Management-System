{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://brightloop-main.onrender.com/api/$1" },
    { "source": "/admin/(.*)", "destination": "https://brightloop-main.onrender.com/admin/$1" },
    { "source": "/static/(.*)", "destination": "https://brightloop-main.onrender.com/static/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
